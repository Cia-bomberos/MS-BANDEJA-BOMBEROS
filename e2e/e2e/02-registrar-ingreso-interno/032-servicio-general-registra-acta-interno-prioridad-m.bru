meta {
  name: Servicio General registra Acta interno, prioridad Media d2_acta_sg
  type: http
  seq: 32
}

post {
  url: {{baseUrl}}/documentos
  body: json
  auth: none
}

headers {
  Authorization: {{token_serviciogeneral}}
}

body:json {
  {
    "origen": "interno",
    "tipo": "Acta",
    "asunto": "Acta de Servicio General: requerimiento de equipos de protección personal",
    "fecha_limite": "{{fecha_40}}",
    "archivo_s3_key": "{{archivoKey}}",
    "prioridad": "Media"
  }
}

script:post-response {
  if (res.body && res.body.id) bru.setVar("d2_acta_sg", res.body.id);
  if (res.body) bru.setVar("d2_acta_sgCodigo", res.body.codigo_unico);
}

tests {
  test("responde 201", function () {
    expect(res.status).to.equal(201);
  });
  test("queda en estado Pendiente", function () {
    expect(res.body.estado).to.equal("Pendiente");
  });
  test("guarda el asunto ingresado", function () {
    expect(res.body.asunto).to.equal("Acta de Servicio General: requerimiento de equipos de protección personal");
  });
  test("guarda la fecha límite ingresada", function () {
    expect(res.body.fecha_limite).to.equal(bru.getVar("fecha_40"));
  });
  test("prioridad Media elegida a mano", function () {
    expect(res.body.prioridad).to.equal("Media");
  });
  test("registro completo del tipo Acta con código institucional", function () {
    expect(res.body.modalidad).to.equal("completo");
    expect(res.body.tipo).to.equal("Acta");
    expect(res.body.codigo_unico).to.match(/^ACTA N° \d{3}-\d{4}\/CGBVP\/IVCDLC\/B3$/);
  });
  test("el código lleva el año en curso de Lima", function () {
    expect(res.body.codigo_unico).to.contain("-" + bru.getVar("anioLima") + "/");
  });
}
