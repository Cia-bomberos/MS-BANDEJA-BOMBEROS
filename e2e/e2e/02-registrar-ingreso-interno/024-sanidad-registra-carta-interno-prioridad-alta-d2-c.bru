meta {
  name: Sanidad registra Carta interno, prioridad Alta d2_carta_san
  type: http
  seq: 24
}

post {
  url: {{baseUrl}}/documentos
  body: json
  auth: none
}

headers {
  Authorization: {{token_sanidad}}
}

body:json {
  {
    "origen": "interno",
    "tipo": "Carta",
    "asunto": "Pedido \"urgente\" de señalización – año 2026 <b>prueba</b> & más 🚒",
    "fecha_limite": "{{fecha_40}}",
    "archivo_s3_key": "{{archivoKey}}",
    "prioridad": "Alta"
  }
}

script:post-response {
  if (res.body && res.body.id) bru.setVar("d2_carta_san", res.body.id);
  if (res.body) bru.setVar("d2_carta_sanCodigo", res.body.codigo_unico);
}

tests {
  test("responde 201", function () {
    expect(res.status).to.equal(201);
  });
  test("queda en estado Pendiente", function () {
    expect(res.body.estado).to.equal("Pendiente");
  });
  test("guarda el asunto ingresado", function () {
    expect(res.body.asunto).to.equal("Pedido \"urgente\" de señalización – año 2026 <b>prueba</b> & más 🚒");
  });
  test("guarda la fecha límite ingresada", function () {
    expect(res.body.fecha_limite).to.equal(bru.getVar("fecha_40"));
  });
  test("prioridad Alta elegida a mano", function () {
    expect(res.body.prioridad).to.equal("Alta");
  });
  test("registro completo del tipo Carta con código institucional", function () {
    expect(res.body.modalidad).to.equal("completo");
    expect(res.body.tipo).to.equal("Carta");
    expect(res.body.codigo_unico).to.match(/^CARTA N° \d{3}-\d{4}\/CGBVP\/IVCDLC\/B3$/);
  });
  test("el código lleva el año en curso de Lima", function () {
    expect(res.body.codigo_unico).to.contain("-" + bru.getVar("anioLima") + "/");
  });
}
