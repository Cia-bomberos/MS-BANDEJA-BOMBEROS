meta {
  name: Pedir URL de subida para el PDF de la validación sin procedencia (Máquinas)
  type: http
  seq: 53
}

post {
  url: {{baseUrl}}/documentos/upload-url
  body: json
  auth: none
}

headers {
  Authorization: {{token_maquinas}}
}

body:json {
  {}
}

script:post-response {
  if (res.body) { bru.setVar("uploadUrl", res.body.uploadUrl); bru.setVar("archivoKey", res.body.archivo_s3_key); }
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });
  test("entrega la URL y la ruta temporal", function () {
    expect(res.body.uploadUrl).to.be.a("string");
    expect(res.body.archivo_s3_key).to.be.a("string");
  });
}
