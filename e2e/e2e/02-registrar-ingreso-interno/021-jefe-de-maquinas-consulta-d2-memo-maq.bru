meta {
  name: Jefe de Máquinas consulta d2_memo_maq
  type: http
  seq: 21
}

get {
  url: {{baseUrl}}/documentos/{{d2_memo_maq}}
  body: none
  auth: none
}

headers {
  Authorization: {{token_maquinas}}
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });
  test("estado Pendiente, a cargo de Máquinas", function () {
    expect(res.body.estado).to.equal("Pendiente");
    expect(res.body.seccion_responsable).to.equal("Maquinas");
  });
  test("esta cuenta puede gestionarlo", function () {
    expect(res.body.solo_lectura).to.equal(false);
  });
  test("el asunto quedó guardado", function () {
    expect(res.body.asunto).to.equal("Memorando de Máquinas: requerimiento de equipos de protección personal");
  });
  test("la fecha límite quedó guardada y no está vencida", function () {
    expect(res.body.fecha_limite).to.equal(bru.getVar("fecha_0"));
    expect(res.body.vencido).to.equal(false);
  });
  test("la sección de origen es Máquinas", function () {
    expect(res.body.seccion_origen).to.equal("Maquinas");
  });
  test("prioridad Alta calculada por el plazo", function () {
    expect(res.body.prioridad).to.equal("Alta");
    expect(res.body.prioridad_manual).to.equal(false);
  });
  test("el PDF quedó en la carpeta definitiva", function () {
    expect(res.body.archivo_s3_key).to.match(/^documentos\/.+\.pdf$/);
  });
  test("guarda la fecha de creación", function () {
    expect(res.body.fecha_creacion).to.be.a("string").and.not.empty;
  });
  test("el historial empieza con el ingreso por Máquinas y su autor", function () {
    const h = (res.body.historial || [])[0];
    expect(h, "entrada de registro").to.exist;
    expect(h.accion).to.equal("registro");
    expect(h.seccion).to.equal("Maquinas");
    expect(h.usuario_nombre).to.be.a("string").and.not.empty;
    expect(h.fecha_hora).to.be.a("string").and.not.empty;
  });
  test("tipo Memorando, registro completo y el mismo código asignado", function () {
    expect(res.body.tipo).to.equal("Memorando");
    expect(res.body.modalidad).to.equal("completo");
    expect(res.body.codigo_unico).to.equal(bru.getVar("d2_memo_maqCodigo"));
  });
}
