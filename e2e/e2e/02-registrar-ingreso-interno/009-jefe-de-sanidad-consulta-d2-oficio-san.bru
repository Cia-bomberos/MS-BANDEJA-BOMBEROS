meta {
  name: Jefe de Sanidad consulta d2_oficio_san
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/documentos/{{d2_oficio_san}}
  body: none
  auth: none
}

headers {
  Authorization: {{token_sanidad}}
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });
  test("estado Pendiente, a cargo de Sanidad", function () {
    expect(res.body.estado).to.equal("Pendiente");
    expect(res.body.seccion_responsable).to.equal("Sanidad");
  });
  test("esta cuenta puede gestionarlo", function () {
    expect(res.body.solo_lectura).to.equal(false);
  });
  test("el asunto quedó guardado", function () {
    expect(res.body.asunto).to.equal("Oficio de Sanidad: requerimiento de equipos de protección personal");
  });
  test("la fecha límite quedó guardada y no está vencida", function () {
    expect(res.body.fecha_limite).to.equal(bru.getVar("fecha_10"));
    expect(res.body.vencido).to.equal(false);
  });
  test("la sección de origen es Sanidad", function () {
    expect(res.body.seccion_origen).to.equal("Sanidad");
  });
  test("prioridad Media calculada por el plazo", function () {
    expect(res.body.prioridad).to.equal("Media");
    expect(res.body.prioridad_manual).to.equal(false);
  });
  test("el PDF quedó en la carpeta definitiva", function () {
    expect(res.body.archivo_s3_key).to.match(/^documentos\/.+\.pdf$/);
  });
  test("guarda la fecha de creación", function () {
    expect(res.body.fecha_creacion).to.be.a("string").and.not.empty;
  });
  test("el historial empieza con el ingreso por Sanidad y su autor", function () {
    const h = (res.body.historial || [])[0];
    expect(h, "entrada de registro").to.exist;
    expect(h.accion).to.equal("registro");
    expect(h.seccion).to.equal("Sanidad");
    expect(h.usuario_nombre).to.be.a("string").and.not.empty;
    expect(h.fecha_hora).to.be.a("string").and.not.empty;
  });
  test("tipo Oficio, registro completo y el mismo código asignado", function () {
    expect(res.body.tipo).to.equal("Oficio");
    expect(res.body.modalidad).to.equal("completo");
    expect(res.body.codigo_unico).to.equal(bru.getVar("d2_oficio_sanCodigo"));
  });
}
