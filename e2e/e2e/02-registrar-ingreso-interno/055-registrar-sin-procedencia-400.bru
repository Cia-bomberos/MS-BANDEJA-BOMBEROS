meta {
  name: Registrar sin procedencia (400)
  type: http
  seq: 55
}

post {
  url: {{baseUrl}}/documentos
  body: json
  auth: none
}

headers {
  Authorization: {{token_maquinas}}
}

body:json {
  {
    "tipo": "Oficio",
    "asunto": "Oficio de Máquinas: requerimiento de equipos de protección personal",
    "fecha_limite": "{{fecha_20}}",
    "archivo_s3_key": "{{archivoKey}}"
  }
}

tests {
  test("responde 400", function () {
    expect(res.status).to.equal(400);
  });
  test("explica el motivo con un mensaje", function () {
    expect(res.body.error).to.be.a("string").and.not.empty;
  });
  test("el mensaje se refiere a origen", function () {
    expect(res.body.error).to.match(/origen/i);
  });
}
