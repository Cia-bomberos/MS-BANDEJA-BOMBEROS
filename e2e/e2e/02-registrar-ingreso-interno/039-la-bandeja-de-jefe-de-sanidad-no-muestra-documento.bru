meta {
  name: La bandeja de Jefe de Sanidad no muestra documentos ajenos
  type: http
  seq: 39
}

get {
  url: {{baseUrl}}/documentos
  body: none
  auth: none
}

headers {
  Authorization: {{token_sanidad}}
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });
  test("ningún documento de otra sección con la que no tuvo relación", function () {
    const ajenos = [bru.getVar("d2_oficio_maq"), bru.getVar("d2_memo_maq")];
    expect(res.body.documentos.filter(x => ajenos.includes(x.id))).to.have.length(0);
  });
}
