meta {
  name: Sanidad registra Oficio interno, prioridad Media d2_oficio_san
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/documentos
  body: json
  auth: none
}

headers {
  Authorization: {{token_sanidad}}
}

body:json {
  {
    "origen": "interno",
    "tipo": "Oficio",
    "asunto": "Oficio de Sanidad: requerimiento de equipos de protección personal",
    "fecha_limite": "{{fecha_10}}",
    "archivo_s3_key": "{{archivoKey}}"
  }
}

script:post-response {
  if (res.body && res.body.id) bru.setVar("d2_oficio_san", res.body.id);
  if (res.body) bru.setVar("d2_oficio_sanCodigo", res.body.codigo_unico);
}

tests {
  test("responde 201", function () {
    expect(res.status).to.equal(201);
  });
  test("queda en estado Pendiente", function () {
    expect(res.body.estado).to.equal("Pendiente");
  });
  test("guarda el asunto ingresado", function () {
    expect(res.body.asunto).to.equal("Oficio de Sanidad: requerimiento de equipos de protección personal");
  });
  test("guarda la fecha límite ingresada", function () {
    expect(res.body.fecha_limite).to.equal(bru.getVar("fecha_10"));
  });
  test("prioridad Media por plazo de 10 días", function () {
    expect(res.body.prioridad).to.equal("Media");
  });
  test("registro completo del tipo Oficio con código institucional", function () {
    expect(res.body.modalidad).to.equal("completo");
    expect(res.body.tipo).to.equal("Oficio");
    expect(res.body.codigo_unico).to.match(/^OFICIO N° \d{3}-\d{4}\/CGBVP\/IVCDLC\/B3$/);
  });
  test("el código lleva el año en curso de Lima", function () {
    expect(res.body.codigo_unico).to.contain("-" + bru.getVar("anioLima") + "/");
  });
  test("el correlativo del Oficio continúa la numeración de la Compañía (+1)", function () {
    const n = String(res.body.codigo_unico).match(/N° (\d+)-/);
    expect(parseInt(n[1], 10)).to.equal(Number(bru.getVar("numOficio")) + 1);
  });
}
