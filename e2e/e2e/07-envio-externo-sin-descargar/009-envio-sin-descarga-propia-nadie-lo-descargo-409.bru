meta {
  name: Envío sin descarga propia: nadie lo descargó (409)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/documentos/{{d7_nunca}}/envio-externo
  body: json
  auth: none
}

headers {
  Authorization: {{token_sanidad}}
}

body:json {
  {"medio": "Mesa de partes", "destinatario": "CGBVP - IV Comandancia Departamental Lima Centro"}
}

tests {
  test("responde 409", function () {
    expect(res.status).to.equal(409);
  });
  test("explica el motivo con un mensaje", function () {
    expect(res.body.error).to.be.a("string").and.not.empty;
  });
  test("el mensaje se refiere a descargar", function () {
    expect(res.body.error).to.match(/descargar/i);
  });
}
