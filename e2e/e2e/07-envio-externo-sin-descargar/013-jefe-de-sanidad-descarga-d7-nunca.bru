meta {
  name: Jefe de Sanidad descarga d7_nunca
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/documentos/{{d7_nunca}}/descargar
  body: none
  auth: none
}

headers {
  Authorization: {{token_sanidad}}
}

script:post-response {
  if (res.body && res.body.downloadUrl) bru.setVar("downloadUrl", res.body.downloadUrl);
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });
  test("entrega una URL de descarga", function () {
    expect(res.body.downloadUrl).to.match(/^https?:\/\//);
  });
}
