meta {
  name: Sanidad registra Informe interno, prioridad Media d7_nunca
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/documentos
  body: json
  auth: none
}

headers {
  Authorization: {{token_sanidad}}
}

body:json {
  {
    "origen": "interno",
    "tipo": "Informe",
    "asunto": "Informe de Sanidad: requerimiento de equipos de protección personal",
    "fecha_limite": "{{fecha_20}}",
    "archivo_s3_key": "{{archivoKey}}"
  }
}

script:post-response {
  if (res.body && res.body.id) bru.setVar("d7_nunca", res.body.id);
  if (res.body) bru.setVar("d7_nuncaCodigo", res.body.codigo_unico);
}

tests {
  test("responde 201", function () {
    expect(res.status).to.equal(201);
  });
  test("queda en estado Pendiente", function () {
    expect(res.body.estado).to.equal("Pendiente");
  });
  test("guarda el asunto ingresado", function () {
    expect(res.body.asunto).to.equal("Informe de Sanidad: requerimiento de equipos de protección personal");
  });
  test("guarda la fecha límite ingresada", function () {
    expect(res.body.fecha_limite).to.equal(bru.getVar("fecha_20"));
  });
  test("prioridad Media por plazo de 20 días", function () {
    expect(res.body.prioridad).to.equal("Media");
  });
  test("registro completo del tipo Informe con código institucional", function () {
    expect(res.body.modalidad).to.equal("completo");
    expect(res.body.tipo).to.equal("Informe");
    expect(res.body.codigo_unico).to.match(/^INFORME N° \d{3}-\d{4}\/CGBVP\/IVCDLC\/B3$/);
  });
  test("el código lleva el año en curso de Lima", function () {
    expect(res.body.codigo_unico).to.contain("-" + bru.getVar("anioLima") + "/");
  });
}
