meta {
  name: d7_jefatura sigue Pendiente
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/documentos/{{d7_jefatura}}
  body: none
  auth: none
}

headers {
  Authorization: {{token_maquinas}}
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });
  test("estado Pendiente, a cargo de Máquinas", function () {
    expect(res.body.estado).to.equal("Pendiente");
    expect(res.body.seccion_responsable).to.equal("Maquinas");
  });
  test("esta cuenta puede gestionarlo", function () {
    expect(res.body.solo_lectura).to.equal(false);
  });
  test("no hay envío en el historial", function () {
    expect((res.body.historial || []).map(h => h.accion)).to.not.include("envio_externo");
  });
}
