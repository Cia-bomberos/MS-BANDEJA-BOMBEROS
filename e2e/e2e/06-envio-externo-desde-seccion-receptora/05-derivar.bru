meta {
  name: Máquinas deriva el Oficio a Sanidad
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/documentos/{{docId}}/derivar
  body: json
  auth: none
}

headers {
  Authorization: {{token}}
}

body:json {
  { "seccion_destino": "Sanidad" }
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });
  test("la sección responsable pasa a Sanidad", function () {
    expect(res.body.seccion_responsable).to.equal("Sanidad");
  });
}
