meta {
  name: Máquinas intenta registrar otro envío (403)
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/documentos/{{docId}}/envio-externo
  body: json
  auth: none
}

headers {
  Authorization: {{token}}
}

body:json {
  { "medio": "Correo institucional", "destinatario": "CGBVP - IV Comandancia", "fecha_envio": "{{fechaLimite}}", "hora_envio": "10:30" }
}

tests {
  test("responde 403", function () {
    expect(res.status).to.equal(403);
  });
}
