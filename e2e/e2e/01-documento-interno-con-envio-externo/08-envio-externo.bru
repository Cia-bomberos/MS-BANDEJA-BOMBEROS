meta {
  name: Intentar el envío sin descargar el documento (409)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/documentos/{{docId}}/envio-externo
  body: json
  auth: none
}

headers {
  Authorization: {{token}}
}

body:json {
  { "medio": "Correo institucional", "destinatario": "CGBVP - IV Comandancia", "fecha_envio": "{{fechaLimite}}", "hora_envio": "10:30" }
}

tests {
  test("responde 409", function () {
    expect(res.status).to.equal(409);
  });
}
