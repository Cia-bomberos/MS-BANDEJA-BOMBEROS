meta {
  name: El documento aparece en la bandeja de Máquinas
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/documentos
  body: none
  auth: none
}

headers {
  Authorization: {{token}}
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });
  test("el documento aparece en la bandeja", function () {
    const doc = res.body.documentos.find(d => d.id === bru.getVar("docId"));
    expect(doc, "documento en la bandeja").to.exist;
  });
  test("aparece en Pendiente", function () {
    const doc = res.body.documentos.find(d => d.id === bru.getVar("docId"));
    expect(doc.estado).to.equal("Pendiente");
  });
}
