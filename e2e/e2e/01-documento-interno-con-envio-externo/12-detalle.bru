meta {
  name: Verificar el cierre del documento
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/documentos/{{docId}}
  body: none
  auth: none
}

headers {
  Authorization: {{token}}
}

tests {
  test("el documento queda Atendido", function () {
    expect(res.body.estado).to.equal("Atendido");
  });
  test("conserva la prioridad asignada", function () {
    expect(res.body.prioridad).to.equal("Alta");
  });
  test("el historial registra prioridad, descarga y envío en orden", function () {
    const a = res.body.historial.map(h => h.accion);
    expect(a).to.include.members(["registro", "prioridad_manual", "descarga", "envio_externo"]);
    expect(a.indexOf("descarga")).to.be.below(a.indexOf("envio_externo"));
  });
  test("el envío guarda medio, destinatario y hora", function () {
    const e = res.body.historial.find(h => h.accion === "envio_externo");
    expect(e.detalle).to.contain("Correo institucional");
    expect(e.detalle).to.contain("CGBVP - IV Comandancia");
    expect(e.detalle).to.contain("10:30");
  });
}
