meta {
  name: Consultar el detalle recién registrado
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/documentos/{{docId}}
  body: none
  auth: none
}

headers {
  Authorization: {{token}}
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });
  test("historial con una entrada de registro", function () {
    expect(res.body.historial.map(h => h.accion)).to.deep.equal(["registro"]);
  });
}
