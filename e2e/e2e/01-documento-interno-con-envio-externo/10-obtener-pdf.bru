meta {
  name: Obtener el PDF desde la URL de descarga
  type: http
  seq: 10
}

get {
  url: {{downloadUrl}}
  body: none
  auth: none
}

tests {
  test("el archivo se descarga (200)", function () {
    expect(res.status).to.equal(200);
  });
  test("es el PDF registrado", function () {
    expect(String(res.body)).to.match(/^%PDF-/);
  });
}
