meta {
  name: Jefe de Máquinas deriva d6_en_proceso a Sanidad
  type: http
  seq: 13
}

patch {
  url: {{baseUrl}}/documentos/{{d6_en_proceso}}/derivar
  body: json
  auth: none
}

headers {
  Authorization: {{token_maquinas}}
}

body:json {
  {"seccion_destino": "Sanidad", "nota": "Para envío a la Comandancia."}
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });
  test("la sección responsable pasa a Sanidad", function () {
    expect(res.body.seccion_responsable).to.equal("Sanidad");
  });
}
