meta {
  name: Jefe de Máquinas descarga d6_pendiente
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/documentos/{{d6_pendiente}}/descargar
  body: none
  auth: none
}

headers {
  Authorization: {{token_maquinas}}
}

script:post-response {
  if (res.body && res.body.downloadUrl) bru.setVar("downloadUrl", res.body.downloadUrl);
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });
  test("entrega una URL de descarga", function () {
    expect(res.body.downloadUrl).to.match(/^https?:\/\//);
  });
}
