meta {
  name: Verificar el cierre por envío de d6_pendiente
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/documentos/{{d6_pendiente}}
  body: none
  auth: none
}

headers {
  Authorization: {{token_maquinas}}
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });
  test("estado Atendido, a cargo de Máquinas", function () {
    expect(res.body.estado).to.equal("Atendido");
    expect(res.body.seccion_responsable).to.equal("Maquinas");
  });
  test("esta cuenta puede gestionarlo", function () {
    expect(res.body.solo_lectura).to.equal(false);
  });
  test("el envío guarda el medio Correo institucional, el destinatario y la fecha", function () {
    const e = (res.body.historial || []).find(h => h.accion === "envio_externo");
    expect(e, "envío en el historial").to.exist;
    expect(e.detalle).to.contain("Correo institucional");
    expect(e.detalle).to.contain("CGBVP - IV Comandancia Departamental Lima Centro");
    expect(e.detalle).to.contain("Enviado el " + bru.getVar("fechaHoy") + " a las ");
  });
}
