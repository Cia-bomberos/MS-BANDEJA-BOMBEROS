meta {
  name: Administración ve el Oficio de Máquinas
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/documentos
  body: none
  auth: none
}

headers {
  Authorization: {{token}}
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });
  test("el documento aparece en la bandeja", function () {
    const doc = res.body.documentos.find(d => d.id === bru.getVar("docId"));
    expect(doc, "documento en la bandeja").to.exist;
  });
  test("aparece en solo lectura", function () {
    const doc = res.body.documentos.find(d => d.id === bru.getVar("docId"));
    expect(doc.solo_lectura).to.equal(true);
  });
}
