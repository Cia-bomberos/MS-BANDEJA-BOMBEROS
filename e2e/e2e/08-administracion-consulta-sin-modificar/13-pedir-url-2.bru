meta {
  name: Pedir URL de subida
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/documentos/upload-url
  body: json
  auth: none
}

headers {
  Authorization: {{token}}
}

body:json {
  {}
}

script:post-response {
  bru.setVar("uploadUrl", res.body.uploadUrl);
  bru.setVar("archivoKey", res.body.archivo_s3_key);
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });
  test("entrega una clave temporal en pendientes/", function () {
    expect(res.body.archivo_s3_key).to.match(/^pendientes\//);
  });
}
