meta {
  name: Administración deriva su propio Oficio a Servicio General
  type: http
  seq: 16
}

patch {
  url: {{baseUrl}}/documentos/{{docPropio}}/derivar
  body: json
  auth: none
}

headers {
  Authorization: {{token}}
}

body:json {
  { "seccion_destino": "ServicioGeneral" }
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });
  test("la sección responsable pasa a ServicioGeneral", function () {
    expect(res.body.seccion_responsable).to.equal("ServicioGeneral");
  });
}
