meta {
  name: Sanidad reemplaza el archivo adjunto
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/documentos/{{docId}}/archivo
  body: json
  auth: none
}

headers {
  Authorization: {{token}}
}

body:json {
  { "archivo_s3_key": "{{archivoKey}}" }
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });
}
