meta {
  name: El documento llega a la bandeja de Sanidad
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/documentos
  body: none
  auth: none
}

headers {
  Authorization: {{token}}
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });
  test("el documento aparece en la bandeja", function () {
    const doc = res.body.documentos.find(d => d.id === bru.getVar("docId"));
    expect(doc, "documento en la bandeja").to.exist;
  });
  test("está En proceso", function () {
    const doc = res.body.documentos.find(d => d.id === bru.getVar("docId"));
    expect(doc.estado).to.equal("En proceso");
  });
  test("Sanidad puede gestionarlo", function () {
    const doc = res.body.documentos.find(d => d.id === bru.getVar("docId"));
    expect(doc.solo_lectura).to.equal(false);
  });
}
