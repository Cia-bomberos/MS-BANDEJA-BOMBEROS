meta {
  name: Administración no puede atender un documento de Servicio General (403)
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/documentos/{{d5_pendiente}}/atender
  body: json
  auth: none
}

headers {
  Authorization: {{token_administracion}}
}

body:json {
  {"nota": "Intento."}
}

tests {
  test("responde 403", function () {
    expect(res.status).to.equal(403);
  });
  test("explica el motivo con un mensaje", function () {
    expect(res.body.error).to.be.a("string").and.not.empty;
  });
}
