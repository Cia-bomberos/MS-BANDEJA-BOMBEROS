meta {
  name: Servicio General marca el documento Pendiente como Atendido con una nota
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/documentos/{{d5_pendiente}}/atender
  body: json
  auth: none
}

headers {
  Authorization: {{token_serviciogeneral}}
}

body:json {
  {"nota": "Se entregó el material solicitado al área de logística."}
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });
}
