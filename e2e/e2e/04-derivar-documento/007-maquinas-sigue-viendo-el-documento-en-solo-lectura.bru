meta {
  name: Máquinas sigue viendo el documento en solo lectura
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/documentos/{{d4_cadena}}
  body: none
  auth: none
}

headers {
  Authorization: {{token_maquinas}}
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });
  test("estado En proceso, a cargo de Administración", function () {
    expect(res.body.estado).to.equal("En proceso");
    expect(res.body.seccion_responsable).to.equal("Administracion");
  });
  test("en solo lectura para esta cuenta", function () {
    expect(res.body.solo_lectura).to.equal(true);
  });
  test("la derivación de Máquinas guarda su nota «Revisar el presupuesto para la compra de equipos.»", function () {
    const x = (res.body.historial || []).filter(h => h.accion === "derivacion")[0];
    expect(x, "derivacion número 1 en el historial").to.exist;
    expect(JSON.stringify(x)).to.contain("Revisar el presupuesto para la compra de equipos.");
  });
}
