meta {
  name: Jefe de Servicio General no puede ver d4_cadena (403)
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/documentos/{{d4_cadena}}
  body: none
  auth: none
}

headers {
  Authorization: {{token_serviciogeneral}}
}

tests {
  test("responde 403", function () {
    expect(res.status).to.equal(403);
  });
  test("explica el motivo con un mensaje", function () {
    expect(res.body.error).to.be.a("string").and.not.empty;
  });
  test("no entrega datos del documento", function () {
    expect(res.body.asunto).to.equal(undefined);
    expect(res.body.historial).to.equal(undefined);
  });
}
