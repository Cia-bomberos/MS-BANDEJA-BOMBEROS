meta {
  name: Servicio General recibe lo derivado por la Jefatura
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/documentos/{{d4_jefatura}}
  body: none
  auth: none
}

headers {
  Authorization: {{token_serviciogeneral}}
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });
  test("estado En proceso, a cargo de Servicio General", function () {
    expect(res.body.estado).to.equal("En proceso");
    expect(res.body.seccion_responsable).to.equal("ServicioGeneral");
  });
  test("esta cuenta puede gestionarlo", function () {
    expect(res.body.solo_lectura).to.equal(false);
  });
  test("la derivación de la Jefatura guarda su nota «La Jefatura asigna el documento a Servicio General.»", function () {
    const x = (res.body.historial || []).filter(h => h.accion === "derivacion")[0];
    expect(x, "derivacion número 1 en el historial").to.exist;
    expect(JSON.stringify(x)).to.contain("La Jefatura asigna el documento a Servicio General.");
  });
}
