meta {
  name: Máquinas deriva un documento externo (RN-0011)
  type: http
  seq: 22
}

patch {
  url: {{baseUrl}}/documentos/{{d4_externo}}/derivar
  body: json
  auth: none
}

headers {
  Authorization: {{token_maquinas}}
}

body:json {
  {"seccion_destino": "Sanidad", "nota": "Externo para Sanidad."}
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });
  test("la sección responsable pasa a Sanidad", function () {
    expect(res.body.seccion_responsable).to.equal("Sanidad");
  });
}
