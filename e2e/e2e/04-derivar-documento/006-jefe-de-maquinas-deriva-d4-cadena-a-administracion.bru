meta {
  name: Jefe de Máquinas deriva d4_cadena a Administración
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/documentos/{{d4_cadena}}/derivar
  body: json
  auth: none
}

headers {
  Authorization: {{token_maquinas}}
}

body:json {
  {"seccion_destino": "Administracion", "nota": "Revisar el presupuesto para la compra de equipos."}
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });
  test("la sección responsable pasa a Administración", function () {
    expect(res.body.seccion_responsable).to.equal("Administracion");
  });
}
