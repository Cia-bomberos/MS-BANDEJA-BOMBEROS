meta {
  name: Jefatura no puede derivar un documento (403)
  type: http
  seq: 16
}

patch {
  url: {{baseUrl}}/documentos/{{d4_jefatura}}/derivar
  body: json
  auth: none
}

headers {
  Authorization: {{token_jefatura}}
}

body:json {
  {"seccion_destino": "ServicioGeneral", "nota": "Intento."}
}

tests {
  test("responde 403", function () {
    expect(res.status).to.equal(403);
  });
  test("explica el motivo con un mensaje", function () {
    expect(res.body.error).to.be.a("string").and.not.empty;
  });
}