meta {
  name: Registrar documento externo
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/documentos
  body: json
  auth: none
}

headers {
  Authorization: {{token}}
}

body:json {
  { "origen": "externo", "fecha_limite": "{{fechaLimite}}", "archivo_s3_key": "{{archivoKey}}" }
}

script:post-response {
  if (res.body && res.body.id) bru.setVar("docExt", res.body.id);
}

tests {
  test("responde 201", function () {
    expect(res.status).to.equal(201);
  });
  test("queda en estado Pendiente", function () {
    expect(res.body.estado).to.equal("Pendiente");
  });
  test("registro simplificado: sin código ni tipo", function () {
    expect(res.body.codigo_unico).to.equal(null);
    expect(res.body.tipo).to.equal(null);
  });
}
