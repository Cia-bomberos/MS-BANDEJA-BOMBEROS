meta {
  name: Intentar registrar otro envío del documento Atendido (409, CU-010)
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/documentos/{{docEnviado}}/envio-externo
  body: json
  auth: none
}

headers {
  Authorization: {{token}}
}

body:json {
  { "medio": "Correo institucional", "destinatario": "CGBVP - IV Comandancia", "fecha_envio": "{{fechaLimite}}", "hora_envio": "11:45" }
}

tests {
  test("responde 409", function () {
    expect(res.status).to.equal(409);
  });
}
