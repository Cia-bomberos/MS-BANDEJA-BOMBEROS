meta {
  name: Administración deriva a Máquinas
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/documentos/{{docId}}/derivar
  body: json
  auth: none
}

headers {
  Authorization: {{token}}
}

body:json {
  { "seccion_destino": "Maquinas" }
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });
  test("la sección responsable pasa a Maquinas", function () {
    expect(res.body.seccion_responsable).to.equal("Maquinas");
  });
}
