meta {
  name: El historial muestra toda la cadena de derivaciones
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/documentos/{{docId}}
  body: none
  auth: none
}

headers {
  Authorization: {{token}}
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });
  test("registra dos derivaciones en orden", function () {
    const d = res.body.historial.filter(h => h.accion === "derivacion").map(h => h.seccion);
    expect(d).to.deep.equal(["ServicioGeneral", "Administracion"]);
  });
  test("la atención la registra Máquinas", function () {
    expect(res.body.historial.find(h => h.accion === "atendido").seccion).to.equal("Maquinas");
  });
}
