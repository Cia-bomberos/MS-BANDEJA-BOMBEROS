meta {
  name: Iniciar sesión como el Jefe de Máquinas
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/documentos
  body: none
  auth: none
}

headers {
  Authorization: {{token}}
}

script:pre-request {
  // Login real contra Cognito (USER_PASSWORD_AUTH) hecho desde el script para que
  // la contraseña y los tokens NO aparezcan en los reportes.
  bru.setVar("loginError", "");
  bru.setVar("token", "");
  const usuario = bru.getProcessEnv("E2E_MAQUINAS_USUARIO");
  const clave = bru.getProcessEnv("E2E_MAQUINAS_PASSWORD");
  if (!usuario || !clave) {
    bru.setVar("loginError", "Faltan las variables E2E_MAQUINAS_USUARIO / E2E_MAQUINAS_PASSWORD");
    return;
  }
  try {
    const r = await bru.sendRequest({
      method: "POST",
      url: "https://cognito-idp.us-east-1.amazonaws.com/",
      headers: {
        "Content-Type": "application/x-amz-json-1.1",
        "X-Amz-Target": "AWSCognitoIdentityProviderService.InitiateAuth"
      },
      data: JSON.stringify({
        AuthFlow: "USER_PASSWORD_AUTH",
        ClientId: bru.getEnvVar("cognitoClientId"),
        AuthParameters: { USERNAME: usuario, PASSWORD: clave }
      })
    });
    const datos = typeof r.data === "string" ? JSON.parse(r.data) : r.data;
    if (datos.ChallengeName) {
      bru.setVar("loginError", "La cuenta pide el reto " + datos.ChallengeName + " (cambiar la contraseña temporal)");
    } else {
      bru.setVar("token", datos.AuthenticationResult.IdToken);
    }
  } catch (e) {
    bru.setVar("loginError", "Cognito rechazó el login (HTTP " + e.status + ")");
  }
}

tests {
  test("el login fue exitoso", function () {
    expect(bru.getVar("loginError"), bru.getVar("loginError")).to.equal("");
  });
  test("el API acepta la sesión (200)", function () {
    expect(res.status).to.equal(200);
  });
}
