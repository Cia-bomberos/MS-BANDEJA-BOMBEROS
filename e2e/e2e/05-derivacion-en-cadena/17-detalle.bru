meta {
  name: Administración (intermedia) consulta el documento en solo lectura
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/documentos/{{docId}}
  body: none
  auth: none
}

headers {
  Authorization: {{token}}
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });
  test("aparece en solo lectura", function () {
    expect(res.body.solo_lectura).to.equal(true);
  });
}
