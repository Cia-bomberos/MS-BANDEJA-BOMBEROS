meta {
  name: La Jefatura ve los documentos de las cuatro secciones
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/documentos
  body: none
  auth: none
}

headers {
  Authorization: {{token}}
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });
  test("aparece el Oficio de Administracion con su sección", function () {
    const d = res.body.documentos.find(x => x.id === bru.getVar("docAdm"));
    expect(d, "documento de Administracion").to.exist;
    expect(d.seccion_responsable).to.equal("Administracion");
  });
  test("aparece el Oficio de ServicioGeneral con su sección", function () {
    const d = res.body.documentos.find(x => x.id === bru.getVar("docSG"));
    expect(d, "documento de ServicioGeneral").to.exist;
    expect(d.seccion_responsable).to.equal("ServicioGeneral");
  });
  test("aparece el Oficio de Maquinas con su sección", function () {
    const d = res.body.documentos.find(x => x.id === bru.getVar("docMaq"));
    expect(d, "documento de Maquinas").to.exist;
    expect(d.seccion_responsable).to.equal("Maquinas");
  });
  test("aparece el Oficio de Sanidad con su sección", function () {
    const d = res.body.documentos.find(x => x.id === bru.getVar("docSan"));
    expect(d, "documento de Sanidad").to.exist;
    expect(d.seccion_responsable).to.equal("Sanidad");
  });
  test("la Jefatura puede gestionarlos (no son de solo lectura)", function () {
    const ids = ['docAdm', 'docSG', 'docMaq', 'docSan'].map(v => bru.getVar(v));
    expect(res.body.documentos.filter(d => ids.includes(d.id)).every(d => d.solo_lectura === false)).to.equal(true);
  });
}
